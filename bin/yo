#!/usr/bin/env bash
# yo, run straight from this working tree, so that a change to yo itself takes
# effect at once. The installed yo (with the graphical interface's libraries)
# is used where needed, and a first run on a new machine goes through Nix.
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export YO_ROOT="${YO_ROOT:-$root}"
export PYTHONPATH="$root/yo${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1

installed=/run/current-system/sw/bin/yo

if [ "${1:-}" = gui ] && [ -x "$installed" ]; then
  exec "$installed" "$@"
fi
if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
  exec python3 -m yo "$@"
fi
if [ -x "$installed" ]; then
  exec "$installed" "$@"
fi
unset PYTHONPATH
exec nix --extra-experimental-features 'nix-command flakes' run "path:$root#yo" -- "$@"
